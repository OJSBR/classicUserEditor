#, fuzzy
msgid "plugins.generic.classicUserEditor.displayName"
msgstr "Erabiltzaileen editore klasikoa"

#, fuzzy
msgid "plugins.generic.classicUserEditor.description"
msgstr "Aldizkariaren kudeatzaileei eta administratzaileei aldizkariko erabiltzaileak zuzenean editatzeko aukera itzultzen die —izena, abizena, helbide elektronikoa eta rolak—, aurreko OJS bertsioetan bezala, Erabiltzaileak eta rolak ataleko fitxa gehigarri batean. OJS 3.5eko gonbidapenen kudeatzailea erabilgarri jarraitzen du haren ondoan."

#, fuzzy
msgid "plugins.generic.classicUserEditor.tab"
msgstr "Editatu erabiltzaileak (klasikoa)"

#, fuzzy
msgid "plugins.generic.classicUserEditor.tab.description"
msgstr "Aldizkari honetan dagoeneko erregistratuta dauden erabiltzaileak zuzenean editatzea: izena, abizena, helbide elektronikoa, rolak, baita kontuak desgaitzea, kentzea, mezuak bidaltzea eta batzea ere. Norbait berria gehitzeko edo berrespena eskatzeko, erabili Erabiltzaileak fitxako gonbidapenen kudeatzailea."

