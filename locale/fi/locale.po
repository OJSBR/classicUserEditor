#, fuzzy
msgid "plugins.generic.classicUserEditor.displayName"
msgstr "Perinteinen käyttäjien muokkain"

#, fuzzy
msgid "plugins.generic.classicUserEditor.description"
msgstr "Palauttaa lehden vastaaville ja ylläpitäjille lehden käyttäjien suoran muokkauksen — etunimi, sukunimi, sähköposti ja roolit — kuten aiemmissa OJS-versioissa, omalla lisävälilehdellä kohdassa Käyttäjät ja roolit. OJS 3.5:n kutsujen hallinta säilyy sen rinnalla."

#, fuzzy
msgid "plugins.generic.classicUserEditor.tab"
msgstr "Muokkaa käyttäjiä (perinteinen)"

#, fuzzy
msgid "plugins.generic.classicUserEditor.tab.description"
msgstr "Tässä lehdessä jo rekisteröityneiden käyttäjien suora muokkaus: etunimi, sukunimi, sähköposti, roolit sekä tilien poistaminen käytöstä, poistaminen, sähköpostitus ja yhdistäminen. Uuden henkilön lisäämiseen tai vahvistuksen pyytämiseen käytä Käyttäjät-välilehden kutsujen hallintaa."

#, fuzzy
msgid "plugins.generic.classicUserEditor.roles.column.role"
msgstr "Rooli"

#, fuzzy
msgid "plugins.generic.classicUserEditor.roles.column.masthead"
msgstr "Näytä toimituskunnan sivulla"

#, fuzzy
msgid "plugins.generic.classicUserEditor.roles.hint"
msgstr "Valitse tämän henkilön roolit lehdessä. Oikeanpuoleisessa sarakkeessa valitse, näkyykö hän kyseisessä roolissa julkisella toimituskunnan sivulla — oletuksena ei näy."

#, fuzzy
