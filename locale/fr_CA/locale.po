msgid "plugins.generic.classicUserEditor.displayName"
msgstr "Éditeur d'utilisateurs classique"

msgid "plugins.generic.classicUserEditor.description"
msgstr "Redonne aux gestionnaires de la revue et aux administrateurs la modification directe des utilisateurs de la revue — prénom, nom, courriel et rôles — comme dans les versions antérieures d'OJS, dans un onglet supplémentaire d'Utilisateurs et rôles. Le gestionnaire d'invitations d'OJS 3.5 demeure disponible en parallèle."

msgid "plugins.generic.classicUserEditor.tab"
msgstr "Modifier les utilisateurs (classique)"

msgid "plugins.generic.classicUserEditor.tab.description"
msgstr "Modification directe des utilisateurs déjà inscrits dans cette revue : prénom, nom, courriel, rôles, ainsi que la désactivation, la suppression, l'envoi de courriels et la fusion des comptes. Pour ajouter une nouvelle personne ou lui demander de confirmer, utilisez le gestionnaire d'invitations de l'onglet Utilisateurs."

msgid "plugins.generic.classicUserEditor.roles.column.role"
msgstr "Rôle"

msgid "plugins.generic.classicUserEditor.roles.column.masthead"
msgstr "Afficher sur la page de l'équipe éditoriale"

msgid "plugins.generic.classicUserEditor.roles.hint"
msgstr "Choisissez les rôles de cette personne dans la revue. Dans la colonne de droite, indiquez si elle doit apparaître sur la page publique de l'équipe éditoriale avec ce rôle — par défaut, elle n'y figure pas."

msgid "plugins.generic.classicUserEditor.roles.notEligible"
msgstr "—"

msgid "plugins.generic.classicUserEditor.roles.notEligible.description"
msgstr "Ce rôle n'apparaît pas sur la page de l'équipe éditoriale. Cela se règle par rôle dans l'onglet Rôles; les évaluateurs y figurent d'après leurs évaluations réalisées, non d'après leur rôle."
