msgid "plugins.generic.classicUserEditor.displayName"
msgstr "Edição Clássica de Usuários"

msgid "plugins.generic.classicUserEditor.description"
msgstr "Devolve ao gerente e ao administrador a edição direta dos usuários da revista — nome, sobrenome, e-mail e papéis — como nas versões anteriores do OJS, em uma aba adicional de Usuários e Papéis. O gerenciador de convites do OJS 3.5 continua disponível em paralelo."

msgid "plugins.generic.classicUserEditor.tab"
msgstr "Editar usuários (clássico)"

msgid "plugins.generic.classicUserEditor.tab.description"
msgstr "Edição direta dos usuários já cadastrados nesta revista: nome, sobrenome, e-mail, papéis, além de desabilitar, remover, enviar e-mail e mesclar contas. Para incluir alguém novo ou pedir a confirmação da pessoa, use o gerenciador de convites na aba Usuários."

msgid "plugins.generic.classicUserEditor.roles.column.role"
msgstr "Papel"

msgid "plugins.generic.classicUserEditor.roles.column.masthead"
msgstr "Exibir na Equipe Editorial"

msgid "plugins.generic.classicUserEditor.roles.hint"
msgstr "Marque os papéis desta pessoa na revista. Na coluna à direita, escolha se ela deve aparecer na página pública Equipe Editorial naquele papel — por padrão, não aparece."

msgid "plugins.generic.classicUserEditor.roles.notEligible"
msgstr "—"

msgid "plugins.generic.classicUserEditor.roles.notEligible.description"
msgstr "Este papel não aparece na página Equipe Editorial. Isso é definido papel a papel na aba Papéis; avaliadores são listados pelos pareceres concluídos, não pelo papel."
