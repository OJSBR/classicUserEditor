#, fuzzy
msgid "plugins.generic.classicUserEditor.displayName"
msgstr "Editor clasic de utilizatori"

#, fuzzy
msgid "plugins.generic.classicUserEditor.description"
msgstr "Le redă managerilor revistei și administratorilor editarea directă a utilizatorilor revistei — prenume, nume, e-mail și roluri — ca în versiunile anterioare de OJS, într-o filă suplimentară din Utilizatori și roluri. Managerul de invitații din OJS 3.5 rămâne disponibil în paralel."

#, fuzzy
msgid "plugins.generic.classicUserEditor.tab"
msgstr "Editare utilizatori (clasic)"

#, fuzzy
msgid "plugins.generic.classicUserEditor.tab.description"
msgstr "Editare directă a utilizatorilor deja înregistrați în această revistă: prenume, nume, e-mail, roluri, precum și dezactivarea, eliminarea, trimiterea de e-mailuri și fuzionarea conturilor. Pentru a adăuga o persoană nouă sau a-i cere confirmarea, folosiți managerul de invitații din fila Utilizatori."

#, fuzzy
